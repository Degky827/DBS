# Production Compose environment template.
#
# Copy to .env (gitignored) or inject the same variables from your secret
# manager. Do not commit real values.
#
#   cp .env.production.example .env
#   openssl rand -hex 32   # INTERNAL_SERVICE_KEY, STORAGE_ENCRYPTION_KEY
#   openssl rand -hex 64   # JWT_SECRET (HS256 deployments)
#
# docker compose up --build -d

# --- Public entry point -----------------------------------------------------
# HTTPS origin users open in the browser. CORS and the refresh cookie rely on
# this exact origin; it must use https:// outside local testing.
APP_ORIGIN=https://bank.example.com
FRONTEND_PORT=8080

# --- PostgreSQL -------------------------------------------------------------
# Use a URL-safe password: it is embedded in the service DATABASE_URL values.
POSTGRES_USER=meridian
POSTGRES_PASSWORD=

# --- JWT --------------------------------------------------------------------
# HS256 (shared secret) or RS256 (asymmetric). All three services read the same
# values. For RS256, base64-encode the PEM files:
#   base64 -w0 jwt-private.pem > jwt-private.b64
# and set JWT_PRIVATE_KEY_BASE64 (auth-service only) plus
# JWT_PUBLIC_KEY_BASE64 (all services). Leave JWT_SECRET empty for RS256.
JWT_ALGORITHM=HS256
JWT_SECRET=
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
JWT_KEY_ID=
JWT_EXPIRES_IN=15m
JWT_ISSUER=auth-service
JWT_AUDIENCE=banking-system

# --- Service-to-service authentication -------------------------------------
INTERNAL_SERVICE_KEY=

# --- KYC document encryption ------------------------------------------------
# Exactly 64 hex characters. Losing this key makes stored documents unreadable.
STORAGE_ENCRYPTION_KEY=

# --- Email (required) -------------------------------------------------------
# Startup fails in production without a Brevo key because email verification
# and password reset cannot be delivered. Use a REST key (xkeysib-...) for
# HTTPS delivery, or an SMTP key (xsmtpsib-...) with the SMTP settings below.
BREVO_API_KEY=
EMAIL_TRANSPORT=
EMAIL_FROM=Meridian Bank
EMAIL_FROM_EMAIL=no-reply@meridianbank.example
EMAIL_SMTP_USER=
EMAIL_SMTP_HOST=smtp-relay.brevo.com
EMAIL_SMTP_PORT=587

# --- Integrations -----------------------------------------------------------

# Required for KYC. The service starts without these, but no verification can
# be performed and wallets remain gated.
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=
DIDIT_WEBHOOK_SECRET_PREVIOUS=

# Chapa Test Mode only; leave blank to keep deposits disabled. When a secret is
# set, CHAPA_WEBHOOK_SECRET (16+ chars), CHAPA_CALLBACK_URL, and CHAPA_RETURN_URL
# are required. CHAPA_BASE_URL must be https://api.chapa.global if overridden.
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=
CHAPA_BASE_URL=https://api.chapa.global
CHAPA_CALLBACK_URL=
CHAPA_RETURN_URL=

# --- Operational tuning -----------------------------------------------------
LOG_LEVEL=info
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10
SENSITIVE_AUTH_RATE_LIMIT_MAX=20
REFRESH_RATE_LIMIT_MAX=60
AUTH_RATE_LIMIT_MAX=20
REFRESH_TOKEN_TTL_MS=604800000
REFRESH_TOKEN_GRACE_MS=30000
REFRESH_COOKIE_SAME_SITE=lax
UPLOAD_RATE_LIMIT_MAX=10
MAX_FILE_SIZE_BYTES=10485760
