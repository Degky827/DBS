# Production Compose environment template.
#
# Copy to .env (gitignored) or inject the same variables from your secret
# manager. Do not commit real values.
#
#   cp .env.production.example .env
#   openssl rand -hex 32   # INTERNAL_SERVICE_KEY, STORAGE_ENCRYPTION_KEY
#   openssl rand -hex 64   # JWT_SECRET (HS256 deployments)
#
# Every secret variable also accepts a <NAME>_FILE companion pointing to a file
# with the value; the file wins. See docs/deployment/environment-setup.md.
#
# docker compose up --build -d

# --- Public entry point -----------------------------------------------------
# HTTPS origin users open in the browser. CORS and the refresh cookie rely on
# this exact origin; it must use https:// outside local testing.
APP_ORIGIN=https://bank.example.com

# --- TLS --------------------------------------------------------------------
# TLS is terminated by the frontend Nginx container by default. Place a
# full-chain certificate at certs/tls.crt and its unencrypted private key at
# certs/tls.key, relative to this Compose file. TLS_ENABLED=true makes startup
# fail if either file is missing. Set TLS_ENABLED=false only when a trusted
# load balancer terminates TLS in front of the stack.
TLS_ENABLED=true
FRONTEND_HTTP_PORT=80
FRONTEND_HTTPS_PORT=443

# --- PostgreSQL -------------------------------------------------------------
# Use a URL-safe password: it is embedded in the service DATABASE_URL values.
POSTGRES_USER=meridian
POSTGRES_PASSWORD=

# --- JWT --------------------------------------------------------------------
# HS256 (shared secret) or RS256 (asymmetric). All three services read the same
# values. For RS256, base64-encode the PEM files:
#   base64 -w0 jwt-private.pem > jwt-private.b64
# and set JWT_PRIVATE_KEY_BASE64 (auth-service only) plus
# JWT_PUBLIC_KEY_BASE64 (all services). Leave JWT_SECRET empty for RS256.
JWT_ALGORITHM=HS256
JWT_SECRET=
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
JWT_KEY_ID=
JWT_EXPIRES_IN=15m
JWT_ISSUER=auth-service
JWT_AUDIENCE=banking-system

# --- Service-to-service authentication -------------------------------------
INTERNAL_SERVICE_KEY=

# --- KYC document encryption ------------------------------------------------
# Exactly 64 hex characters. Losing this key makes stored documents unreadable.
# During rotation, keep the old key(s) in STORAGE_ENCRYPTION_KEYS_PREVIOUS and
# run kyc-service's scripts/rotateEncryptionKey.js (see
# docs/operations/security-and-operations.md).
STORAGE_ENCRYPTION_KEY=
STORAGE_ENCRYPTION_KEYS_PREVIOUS=

# --- Multi-factor authentication --------------------------------------------
# 64 hex characters (openssl rand -hex 32). Recommended: without it, MFA
# secrets and recovery-code hashes are derived from JWT material, so a JWT
# rotation invalidates existing enrolments.
MFA_ENCRYPTION_KEY=
MFA_ISSUER=Meridian Bank
MFA_CHALLENGE_TTL_MS=300000
STEP_UP_TTL_MS=600000

# --- Email (required) -------------------------------------------------------
# Startup fails in production without a Brevo key because email verification
# and password reset cannot be delivered. Use a REST key (xkeysib-...) for
# HTTPS delivery, or an SMTP key (xsmtpsib-...) with the SMTP settings below.
BREVO_API_KEY=
EMAIL_TRANSPORT=
EMAIL_FROM=Meridian Bank
EMAIL_FROM_EMAIL=no-reply@meridianbank.example
EMAIL_SMTP_USER=
EMAIL_SMTP_HOST=smtp-relay.brevo.com
EMAIL_SMTP_PORT=587

# --- Notifications ----------------------------------------------------------
# In-app notifications always work. Set EMAIL_ENABLED=true to also deliver
# notification emails through the Brevo settings above; without a key the
# service stores notifications and skips email.
EMAIL_ENABLED=true
BREVO_API_BASE_URL=https://api.brevo.com/v3
EMAIL_TIMEOUT_MS=8000
EMAIL_RETRY_INTERVAL_MS=30000
EMAIL_MAX_ATTEMPTS=6
NOTIFICATION_PAGE_SIZE=20
INTERNAL_RATE_LIMIT_MAX=300

# --- Integrations -----------------------------------------------------------

# Required for KYC. The service starts without these, but no verification can
# be performed and wallets remain gated.
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=
DIDIT_WEBHOOK_SECRET_PREVIOUS=

# Chapa Test Mode only; leave blank to keep deposits disabled. When a secret is
# set, CHAPA_WEBHOOK_SECRET (16+ chars), CHAPA_CALLBACK_URL, and CHAPA_RETURN_URL
# are required. CHAPA_BASE_URL must be https://api.chapa.global if overridden.
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=
CHAPA_BASE_URL=https://api.chapa.global
CHAPA_CALLBACK_URL=
CHAPA_RETURN_URL=

# --- Operational tuning -----------------------------------------------------
LOG_LEVEL=info
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10
SENSITIVE_AUTH_RATE_LIMIT_MAX=20
REFRESH_RATE_LIMIT_MAX=60
# Redis holds the rate limit windows shared by every replica and a short-lived
# cache of KYC status reads. docker-compose.yml requires REDIS_PASSWORD and fails
# to start without it, because a deployment with several replicas and no Redis
# silently gives each replica its own budget. No financial record lives here:
# losing Redis costs counter accuracy and a cache, never data.
REDIS_PASSWORD=change-me-to-a-long-random-string
REDIS_MAXMEMORY=128mb
AUTH_RATE_LIMIT_MAX=20
REFRESH_TOKEN_TTL_MS=604800000
REFRESH_TOKEN_GRACE_MS=30000
REFRESH_COOKIE_SAME_SITE=lax
UPLOAD_RATE_LIMIT_MAX=10
MAX_FILE_SIZE_BYTES=10485760
STATEMENT_MAX_RANGE_DAYS=366

# Transactional outbox delivery to notification-service. The dispatcher is on
# by default in production and retries with exponential backoff.
OUTBOX_ENABLED=true
OUTBOX_INTERVAL_MS=5000
OUTBOX_BATCH_SIZE=25
OUTBOX_MAX_ATTEMPTS=12

# DB-backed scheduled transfer worker.
SCHEDULED_TRANSFERS_ENABLED=true
SCHEDULED_TRANSFERS_INTERVAL_MS=30000
SCHEDULED_TRANSFERS_BATCH_SIZE=10

# --- Monitoring (optional) --------------------------------------------------
# /metrics is exposed on the private Compose network only. Leave METRICS_TOKEN
# empty unless the endpoint could be reached by an untrusted container; if you
# set it, also configure Prometheus authentication as described in
# docs/operations/security-and-operations.md section 10.
METRICS_TOKEN=
PROMETHEUS_RETENTION=15d

# Alertmanager delivers every notification to the alert-relay container, which
# always writes it to the container log. Set one or both destinations to also
# forward alerts. Slack expects an incoming-webhook URL; the generic webhook
# receives the raw Alertmanager JSON payload.
ALERT_SLACK_WEBHOOK_URL=
ALERT_WEBHOOK_URL=
