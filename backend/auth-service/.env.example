# --- Runtime ---
NODE_ENV=development
PORT=5001

# --- Database (Neon) ---
# pg = TCP 5432 (production / open networks), neon = WebSocket 443 (restricted networks, serverless)
DB_ADAPTER=neon
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# --- JWT ---
JWT_SECRET="generate-with: openssl rand -hex 64"
JWT_EXPIRES_IN=15m
JWT_ISSUER=auth-service
JWT_AUDIENCE=banking-system

# --- Security ---
BCRYPT_ROUNDS=12
CORS_ORIGIN=http://localhost:5173

# --- Email (Brevo) ---
# Two credential types, chosen automatically by the key prefix:
#   xkeysib-...  REST API key  -> HTTPS/443 (works where outbound SMTP is blocked)
#   xsmtpsib-... SMTP key      -> port 587 (requires SMTP to be reachable)
# EMAIL_TRANSPORT=api|smtp overrides the automatic choice.
# Leave BREVO_API_KEY empty to log OTPs to the console instead (development only).
BREVO_API_KEY=
EMAIL_TRANSPORT=
EMAIL_FROM="Meridian Bank"
EMAIL_FROM_EMAIL="no-reply@meridianbank.example"
# SMTP only: your Brevo account login (NOT the sender address).
EMAIL_SMTP_USER=

# --- Logging ---
LOG_LEVEL=info

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# --- API docs (Swagger UI at /api/v1/docs) ---
ENABLE_API_DOCS=true
