# --- Runtime ---
NODE_ENV=development
PORT=5001

# --- Database ---
# pg = TCP 5432 (Compose / managed Postgres), neon = WebSocket 443 (Neon serverless)
DB_ADAPTER=pg
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/auth_db?schema=public"

# --- JWT signing ---
# HS256 (default) or RS256. In production the HS256 secret must be 32+ chars of
# high-entropy data; generate it with: openssl rand -hex 64
JWT_ALGORITHM=HS256
JWT_SECRET=
# RS256 alternative. Provide base64-encoded PEM values so Compose and .env
# parsing do not need literal newlines. All three services must use the same
# algorithm, public key, issuer, and audience.
# JWT_PRIVATE_KEY_BASE64=
# JWT_PUBLIC_KEY_BASE64=
# JWT_KEY_ID=
JWT_EXPIRES_IN=15m
JWT_ISSUER=auth-service
JWT_AUDIENCE=banking-system

# --- Refresh sessions (HttpOnly cookie) ---
# The cookie path must match the URL path the browser calls. With the bundled
# Nginx reverse proxy the browser path is /api/auth; direct service access uses
# /api/v1/auth.
REFRESH_COOKIE_NAME=meridian_refresh
REFRESH_COOKIE_PATH=/api/v1/auth
REFRESH_COOKIE_SAME_SITE=lax
REFRESH_TOKEN_TTL_MS=604800000
REFRESH_TOKEN_GRACE_MS=30000
# Set true whenever the browser reaches the service over HTTPS. Production
# startup fails when this is false.
COOKIE_SECURE=false
# Development escape hatch only: allows COOKIE_SECURE=false in production for
# isolated HTTP testing. Never enable this for a real deployment.
ALLOW_INSECURE_COOKIES=false

# --- Security ---
BCRYPT_ROUNDS=12
# Comma-separated, explicit browser origins. Wildcards are rejected.
CORS_ORIGIN=http://localhost:5173,http://localhost:8080
# Number of trusted reverse-proxy hops (0 when the service is directly exposed).
TRUST_PROXY=0
# Only enable behind HTTPS; the frontend Nginx proxy sets HSTS itself.
ENABLE_HSTS=false
# Shared key guarding internal service-to-service endpoints
# (sent as X-Internal-Service-Key). Generate with: openssl rand -hex 32
INTERNAL_SERVICE_KEY=

# --- Email (Brevo) ---
# Two credential types, chosen automatically by the key prefix:
#   xkeysib-...  REST API key  -> HTTPS/443 (works where outbound SMTP is blocked)
#   xsmtpsib-... SMTP key      -> port 587 (requires SMTP to be reachable)
# EMAIL_TRANSPORT=api|smtp overrides the automatic choice.
# Leave BREVO_API_KEY empty to log OTPs to the console instead (development only).
BREVO_API_KEY=
EMAIL_TRANSPORT=
EMAIL_FROM="Meridian Bank"
EMAIL_FROM_EMAIL="no-reply@meridianbank.example"
# SMTP only: your Brevo account login (NOT the sender address). The SMTP
# password is BREVO_API_KEY (xsmtpsib-... key).
EMAIL_SMTP_USER=
# SMTP only; defaults are smtp-relay.brevo.com:587. Port 465 enables TLS.
EMAIL_SMTP_HOST=smtp-relay.brevo.com
EMAIL_SMTP_PORT=587

# --- Logging ---
LOG_LEVEL=info

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
# Per IP + email pair for login attempts.
LOGIN_RATE_LIMIT_MAX=10
# Register, OTP verification/resend, and password reset.
SENSITIVE_AUTH_RATE_LIMIT_MAX=20
# Cookie refresh and logout.
REFRESH_RATE_LIMIT_MAX=60

# --- API docs (Swagger UI at /api/v1/docs) ---
# Disabled by default in production. If explicitly enabled there, startup
# requires API_DOCS_USERNAME and a 16+ character API_DOCS_PASSWORD.
ENABLE_API_DOCS=true
API_DOCS_USERNAME=
API_DOCS_PASSWORD=
