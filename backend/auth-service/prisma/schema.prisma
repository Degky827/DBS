generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

model User {
    id                String    @id @default(uuid())
    firstName         String
    middleName        String?
    lastName          String
    username          String    @unique
    dateOfBirth       DateTime
    gender            String
    phoneNumber       String
    email             String    @unique
    passwordHash      String
    securityQuestion  String
    securityAnswerHash String
    acceptedTerms     Boolean   @default(false)
    acceptedTermsAt   DateTime?
    role              String    @default("USER")
    isEmailVerified   Boolean   @default(false)
    securityEmailAlerts Boolean @default(true)
    // ACTIVE | FROZEN | SUSPENDED | CLOSED. FROZEN still permits sign-in for
    // read-only account access; SUSPENDED and CLOSED cannot authenticate.
    status            String    @default("ACTIVE")
    statusReason      String?
    statusChangedAt   DateTime?
    statusChangedBy   String?
    closedAt          DateTime?
    mfaEnabled        Boolean   @default(false)
    mfaSecretEncrypted String?
    mfaRecoveryCodeHashes String[] @default([])
    mfaEnrolledAt     DateTime?
    createdAt         DateTime  @default(now())
    updatedAt         DateTime  @updatedAt
    // Access tokens issued before this instant are rejected. Set when the
    // password changes or all sessions are revoked.
    tokenValidAfter   DateTime?
    otpCodes          OtpCode[]
    refreshTokens     RefreshToken[]
    revokedAccessTokens AccessTokenRevocation[]

    @@index([status])
}

model OtpCode {
    id         String    @id @default(uuid())
    userId     String
    user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    email      String
    codeHash   String
    purpose    String
    expiresAt  DateTime
    consumedAt DateTime?
    attempts   Int       @default(0)
    createdAt  DateTime  @default(now())

    @@index([email, purpose])
}

model RefreshToken {
    id                  String    @id @default(uuid())
    userId              String
    user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    tokenHash           String    @unique
    // Tokens issued by one login share a family id. Detecting reuse of any
    // rotated ancestor revokes every active token in the family.
    familyId            String
    // Hard ceiling for the whole login session. Rotation may extend expiresAt
    // up to this instant but never beyond it.
    familyExpiresAt     DateTime?
    replacedByTokenHash String?
    expiresAt           DateTime
    revokedAt           DateTime?
    rotatedAt           DateTime?
    createdAt           DateTime  @default(now())

    @@index([userId])
    @@index([familyId])
}

model AccessTokenRevocation {
    id        String   @id @default(uuid())
    jti       String   @unique
    userId    String
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    reason    String
    expiresAt DateTime
    createdAt DateTime @default(now())

    @@index([userId])
    @@index([expiresAt])
}
