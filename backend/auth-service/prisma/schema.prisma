generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

model User {
    id                String    @id @default(uuid())
    firstName         String
    middleName        String?
    lastName          String
    username          String    @unique
    dateOfBirth       DateTime
    gender            String
    phoneNumber       String
    email             String    @unique
    passwordHash      String
    securityQuestion  String
    securityAnswerHash String
    acceptedTerms     Boolean   @default(false)
    acceptedTermsAt   DateTime?
    role              String    @default("USER")
    isEmailVerified   Boolean   @default(false)
    securityEmailAlerts Boolean @default(true)
    // ACTIVE | FROZEN | SUSPENDED | CLOSED. FROZEN still permits sign-in for
    // read-only account access; SUSPENDED and CLOSED cannot authenticate.
    status            String    @default("ACTIVE")
    statusReason      String?
    statusChangedAt   DateTime?
    statusChangedBy   String?
    closedAt          DateTime?
    mfaEnabled        Boolean   @default(false)
    mfaSecretEncrypted String?
    mfaRecoveryCodeHashes String[] @default([])
    mfaEnrolledAt     DateTime?
    createdAt         DateTime  @default(now())
    updatedAt         DateTime  @updatedAt
    // Access tokens issued before this instant are rejected. Set when the
    // password changes or all sessions are revoked.
    tokenValidAfter   DateTime?
    otpCodes          OtpCode[]
    refreshTokens     RefreshToken[]
    revokedAccessTokens AccessTokenRevocation[]
    loginEvents       LoginEvent[]
    devices           UserDevice[]

    @@index([status])
}

model OtpCode {
    id         String    @id @default(uuid())
    userId     String
    user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    email      String
    codeHash   String
    purpose    String
    expiresAt  DateTime
    consumedAt DateTime?
    attempts   Int       @default(0)
    createdAt  DateTime  @default(now())

    @@index([email, purpose])
}

model RefreshToken {
    id                  String    @id @default(uuid())
    userId              String
    user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    tokenHash           String    @unique
    // Tokens issued by one login share a family id. Detecting reuse of any
    // rotated ancestor revokes every active token in the family.
    familyId            String
    // Hard ceiling for the whole login session. Rotation may extend expiresAt
    // up to this instant but never beyond it.
    familyExpiresAt     DateTime?
    replacedByTokenHash String?
    expiresAt           DateTime
    revokedAt           DateTime?
    rotatedAt           DateTime?
    createdAt           DateTime  @default(now())

    @@index([userId])
    @@index([familyId])
}

model AccessTokenRevocation {
    id        String   @id @default(uuid())
    jti       String   @unique
    userId    String
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    reason    String
    expiresAt DateTime
    createdAt DateTime @default(now())

    @@index([userId])
    @@index([expiresAt])
}

// Login and session-history evidence for fraud detection. Every identifying
// value (ip, device fingerprint, typed identifier) is stored as a SHA-256 hex
// digest, never raw, so this table can be retained and aggregated without
// becoming a surveillance archive.
model LoginEvent {
    id                    String   @id @default(uuid())
    // Nullable: attempts against unknown accounts still need recording, and the
    // trail survives an account removal.
    userId                String?
    user                  User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
    type                  String
    outcome               String
    identifierHash        String?
    ipHash                String?
    ipPrefix              String?
    userAgent             String?
    deviceFingerprintHash String?
    mfaMethod             String?
    failureReason         String?
    correlationId         String?
    occurredAt            DateTime @default(now())
    createdAt             DateTime @default(now())

    @@index([userId, occurredAt])
    @@index([deviceFingerprintHash, occurredAt])
    @@index([ipHash, occurredAt])
    @@index([identifierHash, occurredAt])
    @@index([occurredAt])
}

// Devices the customer has signed in from. A fingerprint that has never been
// seen, or that the customer explicitly un-trusted, is a fraud signal rather
// than a block — the customer decides whether a device is theirs.
model UserDevice {
    id                    String   @id @default(uuid())
    userId                String
    user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    deviceFingerprintHash String
    label                 String?
    userAgent             String?
    firstSeenAt           DateTime @default(now())
    lastSeenAt            DateTime @default(now())
    lastIpHash            String?
    isRecognized          Boolean  @default(false)
    seenCount             Int      @default(1)
    revokedAt             DateTime?
    createdAt             DateTime @default(now())
    updatedAt             DateTime @updatedAt

    @@unique([userId, deviceFingerprintHash])
    @@index([userId, lastSeenAt])
}
