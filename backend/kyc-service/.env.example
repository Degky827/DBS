# --- Runtime ---
NODE_ENV=development
PORT=5003
DB_ADAPTER=pg
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/kyc_db?schema=public"

# --- JWT verification ---
# Every secret also accepts a <NAME>_FILE companion pointing to a file with the
# value; the file wins.
# Use the same algorithm and key material as auth-service.
JWT_ALGORITHM=HS256
# HS256: 32+ character high-entropy secret in production.
JWT_SECRET=
# RS256: base64-encoded PEM public key (verification only).
# JWT_PUBLIC_KEY_BASE64=
JWT_ISSUER=auth-service
JWT_AUDIENCE=banking-system
# Shared key for internal service-to-service routes. Generate with:
# openssl rand -hex 32
INTERNAL_SERVICE_KEY=
USER_SERVICE_URL=http://localhost:5002/api/v1
AUTH_SERVICE_URL=http://localhost:5001/api/v1

# --- Network / security ---
# Comma-separated, explicit browser origins. Wildcards are rejected.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
TRUST_PROXY=0
# Only enable behind HTTPS.
ENABLE_HSTS=false
LOG_LEVEL=info
# Optional bearer token for GET /metrics.
METRICS_TOKEN=
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
UPLOAD_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_MAX=20
# Dedicated budget for the unauthenticated Didit webhook.
WEBHOOK_RATE_LIMIT_MAX=120
# Shared rate limit windows. Unset REDIS_URL to keep counting per process.
REDIS_URL=
REDIS_KEY_PREFIX=kyc
# Approved KYC is valid for this many days before a new application is needed.
KYC_APPROVAL_TTL_DAYS=365

# --- Event delivery and periodic re-verification ---
# Master switch for both in-process jobs (outbox dispatcher and the
# re-verification sweeper). Extra API replicas should set it to false so one
# container owns the jobs.
ENABLE_JOBS=true
# Reminders are written to the kyc-service outbox and delivered to
# notification-service. The dispatcher stays off unless this is enabled and a
# strong INTERNAL_SERVICE_KEY is configured.
OUTBOX_ENABLED=false
NOTIFICATION_SERVICE_URL=
OUTBOX_INTERVAL_MS=5000
OUTBOX_BATCH_SIZE=25
OUTBOX_MAX_ATTEMPTS=12
# Sweep expiring approvals and identity documents on this cadence and create
# officer queue tasks. Enabled by default only in production.
KYC_REVERIFICATION_ENABLED=false
KYC_REVERIFICATION_INTERVAL_MS=21600000
KYC_REVERIFICATION_BATCH_SIZE=200
# Disabled by default in production. If enabled there, API_DOCS_USERNAME and a
# 16+ character API_DOCS_PASSWORD are required.
ENABLE_API_DOCS=true
API_DOCS_USERNAME=
API_DOCS_PASSWORD=

# --- Document storage ---
STORAGE_DIR=./storage
MAX_FILE_SIZE_BYTES=10485760
# Required in production. Generate with: openssl rand -hex 32
# (must be exactly 64 hexadecimal characters; documents cannot be decrypted
# without it after a restart, so store it in a managed secret store.)
STORAGE_ENCRYPTION_KEY=
# Retired keys accepted for decryption during rotation. Comma-separated 64-hex
# values; must not include the current key. Run scripts/rotateEncryptionKey.js
# before removing the last retired key.
STORAGE_ENCRYPTION_KEYS_PREVIOUS=

# --- Didit: API key and webhook signing secret are separate credentials. ---
# Put the published workflow UUID in DIDIT_WORKFLOW_ID (not DIDIT_SECRET_KEY).
DIDIT_API_BASE_URL=https://verification.didit.me
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=
DIDIT_WEBHOOK_SECRET_PREVIOUS=
