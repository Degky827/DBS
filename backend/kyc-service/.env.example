# KYC service environment example
NODE_ENV=development
PORT=5003
DB_ADAPTER=pg
DATABASE_URL="postgresql://auth:auth@localhost:5432/kyc_db?schema=public"
# Must match the shared auth-service JWT secret; use a strong value for production.
JWT_SECRET=change-this-to-a-long-random-string
JWT_ISSUER=auth-service
JWT_AUDIENCE=banking-system
INTERNAL_SERVICE_KEY=dev-internal-service-key
USER_SERVICE_URL=http://localhost:5002/api/v1
AUTH_SERVICE_URL=http://localhost:5001/api/v1
CORS_ORIGIN=http://localhost:8080,http://localhost:5173
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
UPLOAD_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_MAX=20
ENABLE_API_DOCS=true
STORAGE_DIR=./storage
MAX_FILE_SIZE_BYTES=10485760
STORAGE_ENCRYPTION_KEY=replace-with-64-hex-characters

# Didit: API key and webhook signing secret are separate credentials.
# Put the published workflow UUID in DIDIT_WORKFLOW_ID (not DIDIT_SECRET_KEY).
DIDIT_API_BASE_URL=https://verification.didit.me
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=
DIDIT_WEBHOOK_SECRET_PREVIOUS=
