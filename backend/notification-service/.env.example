# Notification service configuration

NODE_ENV=development
PORT=5004
DATABASE_URL=postgresql://meridian:change-me@localhost:5432/notification_db?schema=public
DB_ADAPTER=pg

# Shared JWT configuration with auth-service.
JWT_ALGORITHM=HS256
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=auth-service
JWT_AUDIENCE=banking-system

# Required in production. user-service signs outbox deliveries with this key.
INTERNAL_SERVICE_KEY=replace-with-at-least-32-random-characters
AUTH_SERVICE_URL=http://localhost:5001/api/v1

CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
TRUST_PROXY=0
ENABLE_HSTS=false
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
INTERNAL_RATE_LIMIT_MAX=300
# Shared rate limit windows. Unset REDIS_URL to keep counting per process.
REDIS_URL=
REDIS_KEY_PREFIX=notification
METRICS_TOKEN=

# Email delivery through the Brevo transactional API. Leave BREVO_API_KEY empty
# to keep in-app notifications while skipping email.
EMAIL_ENABLED=false
EMAIL_TRANSPORT=api
BREVO_API_KEY=
BREVO_API_BASE_URL=https://api.brevo.com/v3
EMAIL_FROM=Meridian Bank
EMAIL_FROM_EMAIL=no-reply@example.com
EMAIL_TIMEOUT_MS=8000
EMAIL_RETRY_INTERVAL_MS=30000
EMAIL_MAX_ATTEMPTS=6

APP_ORIGIN=http://localhost:5173
NOTIFICATION_PAGE_SIZE=20
