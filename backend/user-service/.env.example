# --- Runtime ---
NODE_ENV=development
PORT=5002

# --- Database (dedicated user-service DB; do NOT point at auth_db) ---
DB_ADAPTER=pg
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@localhost:5432/user_db?schema=public

# --- Auth mode ---
# dev  = opaque DevSession tokens (standalone development only; rejected in production)
# jwt  = verify access tokens issued by auth-service
AUTH_MODE=jwt
DEV_SESSION_TTL_MS=28800000
# Optional extra header gate for dev auth: require X-Dev-Api-Key when set
DEV_API_KEY=

# --- auth-service integration (required when AUTH_MODE=jwt) ---
# Every secret also accepts a <NAME>_FILE companion pointing to a file with the
# value; the file wins.
# Use the same algorithm and key material as auth-service.
JWT_ALGORITHM=HS256
# HS256: 32+ character high-entropy secret in production.
JWT_SECRET=
# RS256: base64-encoded PEM public key (verification only).
# JWT_PUBLIC_KEY_BASE64=
JWT_ISSUER=auth-service
JWT_AUDIENCE=banking-system
# Base URL of auth-service (no trailing slash). Used to proxy password changes.
AUTH_SERVICE_URL=http://localhost:5001/api/v1
# Base URL of kyc-service (no trailing slash). Wallets, transfers and deposits
# are rejected with 503 KYC_STATUS_UNAVAILABLE when this is unset or unreachable.
KYC_SERVICE_URL=http://localhost:5003/api/v1/kyc
# Shared key required on auth-service and kyc-service internal endpoints
# (X-Internal-Service-Key). Generate with: openssl rand -hex 32
INTERNAL_SERVICE_KEY=
# Maximum age of an MFA step-up verification before sensitive operations
# require re-authentication. Must not exceed the auth-service value.
STEP_UP_TTL_MS=600000
AVATAR_UPLOAD_DIR=./uploads/avatars

# --- Security ---
BCRYPT_ROUNDS=12
# Comma-separated, explicit browser origins. Wildcards are rejected.
CORS_ORIGIN=http://localhost:5173,http://localhost:8080
TRUST_PROXY=0
# Only enable behind HTTPS.
ENABLE_HSTS=false

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
# Dedicated budget for the unauthenticated Chapa webhook.
WEBHOOK_RATE_LIMIT_MAX=120

# --- Logging / docs ---
LOG_LEVEL=info
# Optional bearer token for GET /metrics.
METRICS_TOKEN=
# Disabled by default in production. If enabled there, API_DOCS_USERNAME and a
# 16+ character API_DOCS_PASSWORD are required.
ENABLE_API_DOCS=true
API_DOCS_USERNAME=
API_DOCS_PASSWORD=

# --- Chapa API v2 (Test Mode only; leave blank to keep deposits disabled) ---
# Obtain a CHASECK_TEST- private key and webhook secret from Chapa's test environment.
# Do not put live keys here. Use managed secrets for any deployed environment.
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=
CHAPA_BASE_URL=https://api.chapa.global
# Chapa must be able to reach the HTTPS callback URL.
CHAPA_CALLBACK_URL=
# The frontend route verifies the merchant_reference server-side after redirect.
CHAPA_RETURN_URL=http://localhost:8080/payments

# --- Phase 3: payment reconciliation ---
# Scheduled reconciliation is opt-in. Administrators can always trigger a run
# with POST /api/v1/admin/payments/reconciliation.
RECONCILIATION_ENABLED=false
RECONCILIATION_INTERVAL_MS=300000
RECONCILIATION_STALE_MINUTES=15
RECONCILIATION_BATCH_SIZE=25

# --- Phase 4: double-entry ledger verification ---
# The job re-checks the whole book (journal entries, accounts, transactions,
# withdrawals and payouts) and records a run with any issues it finds. Enabled
# by default in production, disabled in development. Interval is clamped to
# 15 minutes - 24 hours.
LEDGER_VERIFICATION_ENABLED=false
LEDGER_VERIFICATION_INTERVAL_MS=21600000
# A CRITICAL or HIGH finding is published as a ledger.integrity_failed outbox
# event, so the dispatcher and notification-service must be reachable for the
# alert email to admins to arrive.
OUTBOX_ENABLED=true
OUTBOX_INTERVAL_MS=5000
OUTBOX_BATCH_SIZE=25
OUTBOX_MAX_ATTEMPTS=12
NOTIFICATION_SERVICE_URL=http://localhost:5004/api/v1
