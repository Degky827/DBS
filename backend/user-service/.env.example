# --- Runtime ---
NODE_ENV=development
PORT=5002

# --- Database (dedicated user-service DB; do NOT point at auth_db) ---
DB_ADAPTER=pg
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@localhost:5432/user_db?schema=public

# --- Auth mode ---
# dev  = opaque DevSession tokens (standalone development only)
# jwt  = verify access tokens issued by auth-service (Phase 1)
AUTH_MODE=dev
DEV_SESSION_TTL_MS=28800000
# Optional extra header gate for dev auth: require X-Dev-Api-Key when set
DEV_API_KEY=

# --- auth-service integration (required when AUTH_MODE=jwt) ---
# Must match auth-service JWT_SECRET / issuer / audience.
JWT_SECRET=
JWT_ISSUER=auth-service
JWT_AUDIENCE=banking-system
# Base URL of auth-service (no trailing slash). Used to proxy password changes.
AUTH_SERVICE_URL=http://localhost:5001/api/v1
# Shared key required on auth-service internal endpoints (X-Internal-Service-Key).
INTERNAL_SERVICE_KEY=
AVATAR_UPLOAD_DIR=./uploads/avatars

# --- Security ---
BCRYPT_ROUNDS=12
CORS_ORIGIN=*

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# --- Logging / docs ---
LOG_LEVEL=info
ENABLE_API_DOCS=true
