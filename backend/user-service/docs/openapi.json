{
  "openapi": "3.0.3",
  "info": {
    "title": "Digital Banking - User Service (Phase 2, standalone)",
    "version": "1.0.0",
    "description": "Standalone user profile API for Phase 2 development. Uses opaque development sessions (AUTH_MODE=dev) so profile endpoints can be tested without auth-service. This authentication mode is NOT production-ready. See docs/INTEGRATION.md for the JWT integration plan. All responses use the envelope `{ success, message, data | errors }`. Password hashes are never returned.",
    "contact": {
      "name": "User Service Team"
    },
    "license": {
      "name": "UNLICENSED",
      "url": "https://example.com/license"
    }
  },
  "servers": [
    {
      "url": "http://localhost:5002",
      "description": "Local development"
    }
  ],
  "tags": [
    {
      "name": "Health",
      "description": "Service liveness"
    },
    {
      "name": "DevAuth",
      "description": "Development-only session authentication (not production-ready)"
    },
    {
      "name": "Profile",
      "description": "View, update profile and change password"
    },
    {
      "name": "Wallets",
      "description": "Authenticated customer wallet operations"
    },
    {
      "name": "Transactions",
      "description": "Atomic, idempotent wallet transfers and history"
    },
    {
      "name": "Payments",
      "description": "Chapa Test Mode hosted deposits with server-side verification; withdrawals remain disabled"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "tags": ["Health"],
        "summary": "Service root",
        "operationId": "getRoot",
        "security": [],
        "responses": {
          "200": {
            "description": "Service is running",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RootResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Health check",
        "operationId": "getHealth",
        "security": [],
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/dev-login": {
      "post": {
        "tags": ["DevAuth"],
        "summary": "Create a development session",
        "description": "Authenticates a standalone UserProfile with email and password and returns an opaque Bearer token stored (hashed) in DevSession. Development only — not production-ready.",
        "operationId": "devLogin",
        "security": [
          { "devApiKey": [] }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/DevLoginRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Session created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DevLoginResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/api/v1/auth/dev-logout": {
      "post": {
        "tags": ["DevAuth"],
        "summary": "Revoke the current development session",
        "operationId": "devLogout",
        "security": [{ "devBearer": [] }],
        "responses": {
          "200": {
            "description": "Session revoked",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/v1/users/me": {
      "get": {
        "tags": ["Profile"],
        "summary": "View the authenticated user's profile",
        "description": "Returns the safe profile for the user bound to the current development session token. The user id is taken only from the verified session — never from the query string or body. Development Bearer auth is temporary and for local testing only; it is not production JWT integration with auth-service. Sensitive fields (passwordHash, tokens) are never returned.",
        "operationId": "getMyProfile",
        "security": [{ "devBearer": [] }],
        "parameters": [
          {
            "name": "userId",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Ignored. Present only to document that client-supplied user ids cannot select another profile."
          }
        ],
        "responses": {
          "200": {
            "description": "Profile fetched",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProfileResponse" },
                "example": {
                  "success": true,
                  "message": "Profile fetched",
                  "data": {
                    "user": {
                      "id": "3f1c2a8e-0000-4000-8000-000000000001",
                      "firstName": "Demo",
                      "middleName": null,
                      "lastName": "Customer",
                      "username": "demo_user",
                      "email": "demo.user@user.local",
                      "phoneNumber": "+15550100",
                      "dateOfBirth": "1995-06-15T00:00:00.000Z",
                      "gender": "prefer_not_to_say",
                      "city": "Addis Ababa",
                      "country": "Ethiopia",
                      "role": "USER",
                      "createdAt": "2026-10-14T08:12:37.131Z",
                      "updatedAt": "2026-10-14T08:12:37.131Z"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, or expired development session",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" },
                "example": {
                  "success": false,
                  "message": "Authentication token missing"
                }
              }
            }
          },
          "404": {
            "description": "Identified user does not exist",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" },
                "example": {
                  "success": false,
                  "message": "Account not found"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error (details not exposed)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" },
                "example": {
                  "success": false,
                  "message": "Internal server error"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": ["Profile"],
        "summary": "Update permitted profile fields",
        "description": "Updates the authenticated user profile using JSON or multipart/form-data. Multipart requests may include a verified PNG, JPEG, or WebP avatar up to 5 MB; files are stored on the persistent user-service volume. Permitted profile fields are firstName, middleName, lastName, phoneNumber, gender, dateOfBirth, addressLine1, addressLine2, city, state, postalCode, country, bio, and avatarUrl. Protected identity fields are rejected.",
        "operationId": "updateMyProfile",
        "security": [{ "devBearer": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateProfileRequest" },
              "examples": {
                "basic": {
                  "summary": "Update name and contact",
                  "value": {
                    "firstName": "Demo",
                    "lastName": "Customer",
                    "phoneNumber": "+15550100",
                    "city": "Addis Ababa"
                  }
                },
                "clearMiddleName": {
                  "summary": "Clear middle name with empty string",
                  "value": { "middleName": "" }
                }
              }
            },
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "avatar": { "type": "string", "format": "binary", "description": "Optional PNG, JPEG, or WebP image up to 5 MB." },
                  "firstName": { "type": "string" },
                  "middleName": { "type": "string" },
                  "lastName": { "type": "string" },
                  "phoneNumber": { "type": "string" },
                  "gender": { "type": "string" },
                  "dateOfBirth": { "type": "string", "format": "date" },
                  "addressLine1": { "type": "string" },
                  "addressLine2": { "type": "string" },
                  "city": { "type": "string" },
                  "state": { "type": "string" },
                  "postalCode": { "type": "string" },
                  "country": { "type": "string" },
                  "bio": { "type": "string" },
                  "avatarUrl": { "type": "string", "format": "uri" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Profile updated (or unchanged permitted fields written successfully)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProfileResponse" },
                "example": {
                  "success": true,
                  "message": "Profile updated",
                  "data": {
                    "user": {
                      "id": "3f1c2a8e-0000-4000-8000-000000000001",
                      "firstName": "Demo",
                      "lastName": "Customer",
                      "username": "demo_user",
                      "email": "demo.user@user.local",
                      "city": "Addis Ababa",
                      "role": "USER"
                    }
                  }
                }
              }
            }
          },
          "400": {
                        "description": "Validation failed: empty body, invalid profile fields, protected fields, or an invalid, unsupported, or oversized avatar image.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" },
                "example": {
                  "success": false,
                  "message": "Validation failed",
                  "errors": [
                    { "field": "dateOfBirth", "message": "dateOfBirth must be a valid date in the past" }
                  ]
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": {
            "description": "Authenticated user no longer exists",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" },
                "example": { "success": false, "message": "Account not found" }
              }
            }
          },
          "409": {
            "description": "Reserved for future uniqueness conflicts (email/username are not editable here, so not currently returned)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          },
          "500": {
            "description": "Internal server error (details not exposed)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" },
                "example": { "success": false, "message": "Internal server error" }
              }
            }
          }
        }
      }
    },
    "/api/v1/wallets": {
      "post": {
        "tags": ["Wallets"],
        "summary": "Create the authenticated user's wallet",
        "description": "Creates one ETB wallet with a zero balance. Each user may have only one wallet.",
        "operationId": "createMyWallet",
        "security": [{ "devBearer": [] }],
        "responses": {
          "201": {
            "description": "Wallet created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/WalletResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "409": {
            "description": "A wallet already exists for the authenticated user",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          }
        }
      }
    },
    "/api/v1/wallets/me": {
      "get": {
        "tags": ["Wallets"],
        "summary": "Get the authenticated user's wallet and balance",
        "operationId": "getMyWallet",
        "security": [{ "devBearer": [] }],
        "responses": {
          "200": {
            "description": "Wallet fetched",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/WalletResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": {
            "description": "Wallet not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          }
        }
      }
    },
    "/api/v1/wallets/{walletId}": {
      "get": {
        "tags": ["Wallets"],
        "summary": "Get a wallet owned by the authenticated user",
        "operationId": "getWalletById",
        "security": [{ "devBearer": [] }],
        "parameters": [
          {
            "name": "walletId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Wallet fetched",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/WalletResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": {
            "description": "Wallet not found or not owned by the authenticated user",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          }
        }
      }
    },
    "/api/v1/transactions/transfers": {
      "post": {
        "tags": ["Transactions"],
        "summary": "Transfer funds between wallets",
        "description": "Transfers only between wallets in the same currency. Amounts are positive decimal strings with at most two fractional digits. The Idempotency-Key must be reused for retries of the same request.",
        "operationId": "createWalletTransfer",
        "security": [{ "devBearer": [] }],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "minLength": 8, "maxLength": 128 }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TransferRequest" },
              "example": {
                "destinationWalletId": "81cc0680-5dbe-442d-a158-7dce654a344d",
                "amount": "12.50"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Transfer committed",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TransferResponse" }
              }
            }
          },
          "200": {
            "description": "Previously committed idempotent transfer returned",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TransferResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": {
            "description": "Source or destination wallet not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          },
          "409": {
            "description": "Insufficient balance, currency mismatch, or idempotency conflict",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          }
        }
      }
    },
    "/api/v1/transactions": {
      "get": {
        "tags": ["Transactions"],
        "summary": "List the authenticated user's transaction history",
        "description": "Returns a cursor-paginated transfer history visible to the authenticated user. Filter by direction and inclusive ISO 8601 date bounds.",
        "operationId": "listMyTransactions",
        "security": [{ "devBearer": [] }],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 25 }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Transaction id returned by the previous page.",
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "direction",
            "in": "query",
            "schema": { "type": "string", "enum": ["all", "incoming", "outgoing"], "default": "all" }
          },
          {
            "name": "from",
            "in": "query",
            "description": "Inclusive ISO 8601 timestamp lower bound.",
            "schema": { "type": "string", "format": "date-time" }
          },
          {
            "name": "to",
            "in": "query",
            "description": "Inclusive ISO 8601 timestamp upper bound.",
            "schema": { "type": "string", "format": "date-time" }
          }
        ],
        "responses": {
          "200": {
            "description": "Transaction history fetched",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TransactionsResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "404": {
            "description": "Wallet not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          }
        }
      }
    },
    "/api/v1/payments/deposits": {
      "post": {
        "tags": ["Payments"],
        "summary": "Initialize a Chapa Test Mode wallet deposit",
        "description": "Creates an idempotent ETB hosted checkout. A browser redirect never credits the wallet; the provider status must be verified server-side.",
        "operationId": "initializeTestDeposit",
        "security": [{ "devBearer": [] }],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "minLength": 8, "maxLength": 128 }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/DepositRequest" },
              "example": { "amount": "50.00" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Test checkout initialized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PaymentResponse" }
              }
            }
          },
          "200": {
            "description": "Idempotent payment replay",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PaymentResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "409": {
            "description": "Idempotency conflict or inactive wallet",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          },
          "501": {
            "description": "Chapa Test Mode is not configured",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" },
                "example": {
                  "success": false,
                  "message": "External payments are unavailable until Chapa Test Mode is configured"
                }
              }
            }
          },
          "502": {
            "description": "Chapa could not initialize checkout",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          }
        }
      }
    },
    "/api/v1/payments/deposits/{reference}/verify": {
      "get": {
        "tags": ["Payments"],
        "summary": "Verify a returned Chapa deposit",
        "description": "Owner-scoped status check. Calls Chapa's verification API and credits only when provider status, merchant reference, amount, and currency all match.",
        "operationId": "verifyMyDeposit",
        "security": [{ "devBearer": [] }],
        "parameters": [
          {
            "name": "reference",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "maxLength": 20 }
          }
        ],
        "responses": {
          "200": {
            "description": "Provider status verified",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PaymentResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": {
            "description": "Payment not found or not owned by the authenticated user",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          },
          "409": {
            "description": "Provider reference, amount, or currency mismatch",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          },
          "502": {
            "description": "Chapa verification unavailable",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          }
        }
      }
    },
    "/api/v1/payments/webhook": {
      "post": {
        "tags": ["Payments"],
        "summary": "Receive a signed Chapa Test Mode payment webhook",
        "description": "Signature is lowercase-hex HMAC-SHA256 of the exact raw JSON body using CHAPA_WEBHOOK_SECRET. Every event triggers server-side provider verification; duplicate deliveries are idempotent.",
        "operationId": "receiveChapaPaymentWebhook",
        "security": [],
        "parameters": [
          {
            "name": "x-chapa-signature",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["webhook_type", "event", "status", "merchant_reference"],
                "properties": {
                  "webhook_type": { "type": "string", "enum": ["payment"] },
                  "event": {
                    "type": "string",
                    "enum": [
                      "payment.success",
                      "payment.failed",
                      "payment.cancelled",
                      "payment.incomplete",
                      "payment.auth_needed",
                      "payment.blocked"
                    ]
                  },
                  "status": { "type": "string" },
                  "mode": { "type": "string", "enum": ["test"] },
                  "merchant_reference": { "type": "string", "maxLength": 20 },
                  "chapa_reference": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Webhook verified and processed",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PaymentResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "404": {
            "description": "Payment reference is unknown",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          },
          "502": {
            "description": "Chapa verification unavailable",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          }
        }
      }
    },
    "/api/v1/payments/withdrawals": {
      "post": {
        "tags": ["Payments"],
        "summary": "Withdraw funds (not implemented)",
        "description": "Payouts are unsupported and this endpoint never changes wallet balances.",
        "operationId": "createWithdrawalUnavailable",
        "security": [{ "devBearer": [] }],
        "responses": {
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "501": {
            "description": "Payout flow is unsupported",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" },
                "example": {
                  "success": false,
                  "message": "Chapa payouts are not supported by this service"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/transactions/{reference}": {
      "get": {
        "tags": ["Transactions"],
        "summary": "Get a transaction visible to the authenticated user",
        "operationId": "getMyTransaction",
        "security": [{ "devBearer": [] }],
        "parameters": [
          {
            "name": "reference",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Transaction fetched",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TransactionResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": {
            "description": "Transaction not found or not visible to the authenticated user",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/me/password": {
      "patch": {
        "tags": ["Profile"],
        "summary": "Change password",
        "description": "Changes the authenticated user password. The new password must be 8-72 characters and differ from the current password; confirmation must match. Validation responses include field-specific messages.",
        "operationId": "changeMyPassword",
        "security": [{ "devBearer": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ChangePasswordRequest" },
              "examples": {
                "change": {
                  "summary": "Change password",
                  "value": {
                    "currentPassword": "CurrentPass@123",
                    "newPassword": "BrandNewPass@123",
                    "confirmNewPassword": "BrandNewPass@123"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password changed",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageResponse" },
                "example": {
                  "success": true,
                  "message": "Password has been changed. Other development sessions were revoked."
                }
              }
            }
          },
          "400": {
            "description": "Validation failed (missing/empty/unexpected fields, newPassword under 8 characters, confirmation mismatch, new password identical to current) or unsafe request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" },
                "example": {
                  "success": false,
                  "message": "Validation failed",
                  "errors": { "newPassword": "newPassword must be at least 8 characters" }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized or incorrect current password",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" },
                "example": {
                  "success": false,
                  "message": "Current password is incorrect"
                }
              }
            }
          },
          "404": {
            "description": "Authenticated user no longer exists",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" },
                "example": { "success": false, "message": "Account not found" }
              }
            }
          },
          "429": { "$ref": "#/components/responses/TooManyRequests" },
          "500": {
            "description": "Internal server error (details not exposed; no false success)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" },
                "example": { "success": false, "message": "Internal server error" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "devBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Opaque development session token from POST /api/v1/auth/dev-login. NOT a production JWT."
      },
      "devApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Dev-Api-Key",
        "description": "Optional. Required only when DEV_API_KEY is configured."
      }
    },
    "schemas": {
      "ErrorEnvelope": {
        "type": "object",
        "required": ["success", "message"],
        "properties": {
          "success": { "type": "boolean", "enum": [false] },
          "message": { "type": "string" },
          "errors": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          }
        }
      },
      "SuccessEnvelope": {
        "type": "object",
        "required": ["success", "message", "data"],
        "properties": {
          "success": { "type": "boolean", "enum": [true] },
          "message": { "type": "string" },
          "data": {}
        }
      },
      "RootResponse": {
        "allOf": [
          { "$ref": "#/components/schemas/SuccessEnvelope" },
          {
            "type": "object",
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "service": { "type": "string" },
                  "version": { "type": "string" },
                  "authMode": { "type": "string" },
                  "warning": { "type": "string" }
                }
              }
            }
          }
        ]
      },
      "HealthResponse": {
        "allOf": [
          { "$ref": "#/components/schemas/SuccessEnvelope" },
          {
            "type": "object",
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "service": { "type": "string" },
                  "status": { "type": "string" },
                  "uptime": { "type": "integer" },
                  "timestamp": { "type": "string", "format": "date-time" }
                }
              }
            }
          }
        ]
      },
      "MessageResponse": {
        "type": "object",
        "required": ["success", "message"],
        "properties": {
          "success": { "type": "boolean" },
          "message": { "type": "string" },
          "data": { "type": "object", "nullable": true }
        }
      },
      "DevLoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string", "format": "password" }
        }
      },
      "DevLoginResponse": {
        "allOf": [
          { "$ref": "#/components/schemas/SuccessEnvelope" },
          {
            "type": "object",
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "token": { "type": "string" },
                  "tokenType": { "type": "string", "example": "Bearer" },
                  "expiresInMs": { "type": "integer" },
                  "warning": { "type": "string" },
                  "user": {
                    "type": "object",
                    "properties": {
                      "id": { "type": "string", "format": "uuid" },
                      "email": { "type": "string" },
                      "role": { "type": "string" },
                      "firstName": { "type": "string" },
                      "lastName": { "type": "string" },
                      "username": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "Wallet": {
        "type": "object",
        "required": ["id", "balance", "currency", "isActive", "createdAt", "updatedAt"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "balance": { "type": "string", "pattern": "^\\d+\\.\\d{2}$", "example": "0.00" },
          "currency": { "type": "string", "pattern": "^[A-Z]{3}$", "example": "ETB" },
          "isActive": { "type": "boolean", "example": true },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "WalletResponse": {
        "allOf": [
          { "$ref": "#/components/schemas/SuccessEnvelope" },
          {
            "type": "object",
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "wallet": { "$ref": "#/components/schemas/Wallet" }
                }
              }
            }
          }
        ]
      },
      "TransferRequest": {
        "type": "object",
        "required": ["destinationWalletId", "amount"],
        "additionalProperties": false,
        "properties": {
          "destinationWalletId": { "type": "string", "format": "uuid" },
          "amount": {
            "type": "string",
            "pattern": "^(?:0|[1-9]\\d{0,16})(?:\\.\\d{1,2})?$",
            "example": "12.50",
            "description": "Positive amount; at most two fractional digits."
          }
        }
      },
      "Transaction": {
        "type": "object",
        "required": ["id", "reference", "type", "sourceWalletId", "destinationWalletId", "amount", "createdAt"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "reference": { "type": "string", "format": "uuid" },
          "type": { "type": "string", "enum": ["TRANSFER", "DEPOSIT"] },
          "sourceWalletId": { "type": "string", "format": "uuid", "nullable": true },
          "destinationWalletId": { "type": "string", "format": "uuid" },
          "amount": { "type": "string", "pattern": "^\\d+\\.\\d{2}$" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "TransferResponse": {
        "allOf": [
          { "$ref": "#/components/schemas/SuccessEnvelope" },
          {
            "type": "object",
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "transaction": { "$ref": "#/components/schemas/Transaction" }
                }
              }
            }
          }
        ]
      },
      "TransactionResponse": {
        "$ref": "#/components/schemas/TransferResponse"
      },
      "TransactionsResponse": {
        "allOf": [
          { "$ref": "#/components/schemas/SuccessEnvelope" },
          {
            "type": "object",
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "transactions": {
                    "type": "array",
                    "items": { "$ref": "#/components/schemas/Transaction" }
                  },
                  "page": {
                    "type": "object",
                    "required": ["limit", "hasMore", "nextCursor"],
                    "properties": {
                      "limit": { "type": "integer" },
                      "hasMore": { "type": "boolean" },
                      "nextCursor": { "type": "string", "format": "uuid", "nullable": true }
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "DepositRequest": {
        "type": "object",
        "required": ["amount"],
        "additionalProperties": false,
        "properties": {
          "amount": {
            "type": "string",
            "pattern": "^(?:[1-9]\\d{0,16})(?:\\.\\d{1,2})?$",
            "example": "50.00",
            "description": "ETB amount, minimum 1.00. Chapa receives the equivalent integer number of cents."
          }
        }
      },
      "Payment": {
        "type": "object",
        "required": ["id", "reference", "provider", "type", "status", "amount", "currency", "createdAt", "updatedAt"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "reference": { "type": "string", "maxLength": 20 },
          "provider": { "type": "string", "enum": ["CHAPA"] },
          "providerRef": { "type": "string", "nullable": true },
          "type": { "type": "string", "enum": ["DEPOSIT"] },
          "status": { "type": "string", "enum": ["PENDING", "COMPLETED", "FAILED"] },
          "amount": { "type": "string", "pattern": "^\\d+\\.\\d{2}$" },
          "currency": { "type": "string", "enum": ["ETB"] },
          "checkoutUrl": { "type": "string", "format": "uri", "nullable": true },
          "failureReason": { "type": "string", "nullable": true },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "PaymentResponse": {
        "allOf": [
          { "$ref": "#/components/schemas/SuccessEnvelope" },
          {
            "type": "object",
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "payment": { "$ref": "#/components/schemas/Payment" }
                }
              }
            }
          }
        ]
      },
      "UserProfile": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "firstName": { "type": "string" },
          "middleName": { "type": "string", "nullable": true },
          "lastName": { "type": "string" },
          "username": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "phoneNumber": { "type": "string" },
          "dateOfBirth": { "type": "string", "format": "date-time" },
          "gender": { "type": "string" },
          "addressLine1": { "type": "string", "nullable": true },
          "addressLine2": { "type": "string", "nullable": true },
          "city": { "type": "string", "nullable": true },
          "state": { "type": "string", "nullable": true },
          "postalCode": { "type": "string", "nullable": true },
          "country": { "type": "string", "nullable": true },
          "bio": { "type": "string", "nullable": true },
          "avatarUrl": { "type": "string", "nullable": true },
          "role": { "type": "string" },
          "passwordChangedAt": { "type": "string", "format": "date-time", "nullable": true },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "ProfileResponse": {
        "allOf": [
          { "$ref": "#/components/schemas/SuccessEnvelope" },
          {
            "type": "object",
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "user": { "$ref": "#/components/schemas/UserProfile" }
                }
              }
            }
          }
        ]
      },
      "UpdateProfileRequest": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": false,
        "properties": {
          "firstName": { "type": "string", "minLength": 2, "maxLength": 60 },
          "middleName": { "type": "string", "minLength": 2, "maxLength": 60, "nullable": true },
          "lastName": { "type": "string", "minLength": 2, "maxLength": 60 },
          "phoneNumber": { "type": "string", "pattern": "^\\+?[0-9]{7,15}$" },
          "gender": { "type": "string", "enum": ["male", "female", "other", "prefer_not_to_say"] },
          "dateOfBirth": { "type": "string", "format": "date" },
          "addressLine1": { "type": "string", "maxLength": 200 },
          "addressLine2": { "type": "string", "maxLength": 200 },
          "city": { "type": "string", "maxLength": 100 },
          "state": { "type": "string", "maxLength": 100 },
          "postalCode": { "type": "string", "maxLength": 20 },
          "country": { "type": "string", "maxLength": 100 },
          "bio": { "type": "string", "maxLength": 500 },
          "avatarUrl": { "type": "string", "format": "uri", "maxLength": 500 }
        }
      },
      "ChangePasswordRequest": {
        "type": "object",
        "required": ["currentPassword", "newPassword", "confirmNewPassword"],
        "additionalProperties": false,
        "properties": {
          "currentPassword": { "type": "string", "format": "password" },
          "newPassword": {
            "type": "string",
            "format": "password",
            "minLength": 8,
            "maxLength": 72,
            "description": "8-72 characters. Must differ from currentPassword."
          },
          "confirmNewPassword": { "type": "string", "format": "password" }
        }
      }
    },
    "responses": {
      "ValidationError": {
        "description": "Validation failed",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
          }
        }
      },
      "Unauthorized": {
        "description": "Unauthorized",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
          }
        }
      },
      "TooManyRequests": {
        "description": "Rate limited",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
          }
        }
      }
    }
  }
}
