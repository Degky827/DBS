# Render demonstration environment (production profile).
#
# This file documents every variable the consolidated Render service reads.
# Do not commit a filled copy. Values marked REQUIRED must be set in the
# Render Dashboard (the Blueprint marks them sync: false).
#
# Render injects PORT and RENDER_EXTERNAL_URL automatically. The entrypoint
# derives APP_ORIGIN and CORS_ORIGIN from RENDER_EXTERNAL_URL unless you pin
# them here.
#
# Generate secrets locally:
#   openssl rand -hex 32   # STORAGE_ENCRYPTION_KEY, MFA_ENCRYPTION_KEY
#   openssl rand -hex 48   # DEMO_SEED_PASSWORD (or any 12+ random characters)
# JWT_SECRET and INTERNAL_SERVICE_KEY are generated by Render (generateValue).

# --- Public origin -----------------------------------------------------------
# Leave unset to use RENDER_EXTERNAL_URL. If the dashboard assigns a custom
# domain, set both to that HTTPS origin.
# APP_ORIGIN=https://dbs-demo.onrender.com
# CORS_ORIGIN=https://dbs-demo.onrender.com

# --- Runtime -----------------------------------------------------------------
NODE_ENV=production
LOG_LEVEL=info
# Two proxies in front of each service: Render's edge and the bundled Nginx.
TRUST_PROXY=2
ENABLE_HSTS=true
ENABLE_API_DOCS=false

# --- JWT ---------------------------------------------------------------------
JWT_ALGORITHM=HS256
JWT_SECRET=
# RS256 alternative (leave JWT_SECRET empty):
# JWT_PRIVATE_KEY_BASE64=
# JWT_PUBLIC_KEY_BASE64=
# JWT_KEY_ID=
JWT_EXPIRES_IN=15m
JWT_ISSUER=auth-service
JWT_AUDIENCE=banking-system

# --- Service-to-service authentication --------------------------------------
INTERNAL_SERVICE_KEY=

# --- Refresh cookie (same-origin gateway) -----------------------------------
REFRESH_COOKIE_NAME=meridian_refresh
REFRESH_COOKIE_PATH=/api/auth
REFRESH_COOKIE_SAME_SITE=lax
COOKIE_SECURE=true
REFRESH_TOKEN_TTL_MS=604800000
REFRESH_TOKEN_ABSOLUTE_TTL_MS=2592000000
REFRESH_TOKEN_GRACE_MS=30000

# --- MFA ---------------------------------------------------------------------
# 64 hex characters. Without it, MFA secrets derive from JWT material.
MFA_ENCRYPTION_KEY=
MFA_ISSUER=Meridian Bank
MFA_CHALLENGE_TTL_MS=300000
STEP_UP_TTL_MS=600000

# --- PostgreSQL (Neon, one database per service) ----------------------------
# Neon requires TLS: append ?sslmode=require. The project can host all four
# databases; only the database name differs between these URLs.
DB_ADAPTER=pg
AUTH_DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
USER_DATABASE_URL=postgresql://USER:PASSWORD@HOST/user_db?sslmode=require
KYC_DATABASE_URL=postgresql://USER:PASSWORD@HOST/kyc_db?sslmode=require
NOTIFICATION_DATABASE_URL=postgresql://USER:PASSWORD@HOST/notification_db?sslmode=require

# --- Redis (Upstash, optional) ----------------------------------------------
# Rate-limit windows and the KYC status cache only. Unset = per-process
# counters, which is safe because exactly one instance of each service runs.
# REDIS_URL=rediss://default:TOKEN@HOST:6379

# --- Internal service URLs (same container) ---------------------------------
AUTH_MODE=jwt
AUTH_SERVICE_URL=http://127.0.0.1:5001/api/v1
USER_SERVICE_URL=http://127.0.0.1:5002/api/v1
KYC_SERVICE_URL=http://127.0.0.1:5003/api/v1/kyc
NOTIFICATION_SERVICE_URL=http://127.0.0.1:5004/api/v1

# --- File storage (no persistent disk on Render free) -----------------------
STORAGE_BACKEND=postgres
AVATAR_STORAGE_BACKEND=postgres
STORAGE_ENCRYPTION_KEY=
STORAGE_ENCRYPTION_KEYS_PREVIOUS=
MAX_FILE_SIZE_BYTES=10485760

# --- Email (required in production) -----------------------------------------
# Render free blocks SMTP ports 25/465/587: use an HTTPS provider key —
# Brevo REST (xkeysib-) or SendGrid (SG.). Set ONE of the two keys; leave
# EMAIL_TRANSPORT unset to auto-detect (SendGrid wins if both are set), or pin
# it explicitly to api (Brevo) or sendgrid. EMAIL_FROM_EMAIL must be a sender
# verified with the chosen provider.
BREVO_API_KEY=
SENDGRID_API_KEY=
# EMAIL_TRANSPORT=sendgrid
EMAIL_FROM=Meridian Bank
EMAIL_FROM_EMAIL=your-verified-sender@example.com
EMAIL_ENABLED=true
BREVO_API_BASE_URL=https://api.brevo.com/v3
SENDGRID_API_BASE_URL=https://api.sendgrid.com
EMAIL_TIMEOUT_MS=8000
EMAIL_RETRY_INTERVAL_MS=30000
EMAIL_MAX_ATTEMPTS=6
NOTIFICATION_PAGE_SIZE=20
INTERNAL_RATE_LIMIT_MAX=300

# --- Background jobs (exactly one container) --------------------------------
ENABLE_JOBS=true
OUTBOX_ENABLED=true
OUTBOX_INTERVAL_MS=5000
OUTBOX_BATCH_SIZE=25
OUTBOX_MAX_ATTEMPTS=12
SCHEDULED_TRANSFERS_ENABLED=true
SCHEDULED_TRANSFERS_INTERVAL_MS=30000
SCHEDULED_TRANSFERS_BATCH_SIZE=10
LEDGER_VERIFICATION_ENABLED=true
LEDGER_VERIFICATION_INTERVAL_MS=21600000
KYC_REVERIFICATION_ENABLED=true
KYC_REVERIFICATION_INTERVAL_MS=21600000
KYC_REVERIFICATION_BATCH_SIZE=200
KYC_APPROVAL_TTL_DAYS=365
STATEMENT_MAX_RANGE_DAYS=366
KYC_STATUS_CACHE_TTL_SECONDS=10

# --- Chapa (sandbox only; empty keeps deposits disabled) --------------------
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=
CHAPA_BASE_URL=https://api.chapa.global
CHAPA_CALLBACK_URL=
CHAPA_RETURN_URL=
RECONCILIATION_ENABLED=false
RECONCILIATION_INTERVAL_MS=300000
RECONCILIATION_STALE_MINUTES=15
RECONCILIATION_BATCH_SIZE=25

# --- Didit KYC (empty keeps provider verification disabled) -----------------
DIDIT_API_BASE_URL=https://verification.didit.me
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=
DIDIT_WEBHOOK_SECRET_PREVIOUS=

# --- Rate limits -------------------------------------------------------------
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10
SENSITIVE_AUTH_RATE_LIMIT_MAX=20
REFRESH_RATE_LIMIT_MAX=60
AUTH_RATE_LIMIT_MAX=20
WEBHOOK_RATE_LIMIT_MAX=120
UPLOAD_RATE_LIMIT_MAX=10

# --- Demonstration data ------------------------------------------------------
# Synthetic accounts only. DEMO_SEED_PASSWORD is applied to the seeded demo
# accounts; anyone with this URL can log in, so never put real data here.
DEMO_SEED_ENABLED=true
DEMO_SEED_PASSWORD=

# --- Optional ---------------------------------------------------------------
# METRICS_TOKEN=
