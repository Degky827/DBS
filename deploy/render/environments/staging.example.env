# Render staging environment (optional second blueprint environment).
#
# Same consolidated image as production, pointed at separate Neon databases
# and a separate Render service/URL. Use this profile when you want to try a
# deploy without touching the demonstration database. Fill values through the
# Render Dashboard; never commit them.
#
# Render injects PORT and RENDER_EXTERNAL_URL. APP_ORIGIN/CORS_ORIGIN default
# to the service URL.

NODE_ENV=production
LOG_LEVEL=debug
# Two proxies in front of each service: Render's edge and the bundled Nginx.
TRUST_PROXY=2
ENABLE_HSTS=true
ENABLE_API_DOCS=false

JWT_ALGORITHM=HS256
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_ISSUER=auth-service
JWT_AUDIENCE=banking-system
INTERNAL_SERVICE_KEY=

REFRESH_COOKIE_NAME=meridian_refresh
REFRESH_COOKIE_PATH=/api/auth
REFRESH_COOKIE_SAME_SITE=lax
COOKIE_SECURE=true

MFA_ENCRYPTION_KEY=
MFA_ISSUER=Meridian Bank

# Separate Neon databases (for example a second Neon project or separate
# branches). TLS is mandatory for Neon.
DB_ADAPTER=pg
AUTH_DATABASE_URL=postgresql://USER:PASSWORD@HOST/staging_auth?sslmode=require
USER_DATABASE_URL=postgresql://USER:PASSWORD@HOST/staging_user?sslmode=require
KYC_DATABASE_URL=postgresql://USER:PASSWORD@HOST/staging_kyc?sslmode=require
NOTIFICATION_DATABASE_URL=postgresql://USER:PASSWORD@HOST/staging_notification?sslmode=require

# Optional Upstash database. Different prefix keys keep staging counters apart
# if the same instance is ever shared (not recommended).
# REDIS_URL=rediss://default:TOKEN@HOST:6379

AUTH_MODE=jwt
AUTH_SERVICE_URL=http://127.0.0.1:5001/api/v1
USER_SERVICE_URL=http://127.0.0.1:5002/api/v1
KYC_SERVICE_URL=http://127.0.0.1:5003/api/v1/kyc
NOTIFICATION_SERVICE_URL=http://127.0.0.1:5004/api/v1

STORAGE_BACKEND=postgres
AVATAR_STORAGE_BACKEND=postgres
STORAGE_ENCRYPTION_KEY=
STORAGE_ENCRYPTION_KEYS_PREVIOUS=
MAX_FILE_SIZE_BYTES=10485760

BREVO_API_KEY=
EMAIL_TRANSPORT=api
EMAIL_FROM=Meridian Bank (Staging)
EMAIL_FROM_EMAIL=no-reply@your-verified-domain.example
EMAIL_ENABLED=true
BREVO_API_BASE_URL=https://api.brevo.com/v3

ENABLE_JOBS=true
OUTBOX_ENABLED=true
SCHEDULED_TRANSFERS_ENABLED=true
LEDGER_VERIFICATION_ENABLED=true
KYC_REVERIFICATION_ENABLED=true

CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=
CHAPA_BASE_URL=https://api.chapa.global
CHAPA_CALLBACK_URL=
CHAPA_RETURN_URL=

DIDIT_API_BASE_URL=https://verification.didit.me
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=

BCRYPT_ROUNDS=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
LOGIN_RATE_LIMIT_MAX=20

DEMO_SEED_ENABLED=true
DEMO_SEED_PASSWORD=
