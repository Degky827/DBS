# Development (Vite dev server on http://localhost:5173).
# The service must include this origin in CORS_ORIGIN and allow credentials.
VITE_AUTH_API=http://localhost:5001/api/v1
VITE_USER_API=http://localhost:5002/api/v1
VITE_KYC_API=http://localhost:5003/api/v1/kyc

# Production builds default to same-origin relative paths behind the bundled
# Nginx proxy:
#   VITE_AUTH_API=/api/auth
#   VITE_USER_API=/api/user
#   VITE_KYC_API=/api/kyc
# Leave the values above unchanged for Docker builds; the image sets defaults.
